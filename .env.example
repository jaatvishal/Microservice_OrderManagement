# Copy these into your shell or user-secrets. Do not commit real values.
# PowerShell:  $env:ConnectionStrings__IdentityDb = "..."
# bash:        export ConnectionStrings__IdentityDb="..."

ConnectionStrings__IdentityDb=Server=localhost,1433;Database=IdentityDb;User Id=sa;Password=<strong-password>;TrustServerCertificate=True
ConnectionStrings__ProductDb=Server=localhost,1433;Database=ProductDb;User Id=sa;Password=<strong-password>;TrustServerCertificate=True
Jwt__SigningKey=<random-value-at-least-32-characters>
Jwt__Issuer=ecommerce-identity
Jwt__Audience=ecommerce-api
Database__ApplyMigrations=true
Database__SeedSampleCatalog=true

# Optional. Honored only when ASPNETCORE_ENVIRONMENT=Development.
# Seed__AdminEmail=admin@example.com
# Seed__AdminPassword=<strong-password>
